@@ -0,0 +1,293 @@
+"""Idempotency, absorbing terminal states, cancel, the outbox, and crash safety."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+from conftest import RecordingNotifier, cmd
+
+from relay.dispatcher import Dispatcher
+from relay.notifier import NotifyError
+
+DRIVER = os.path.join(os.path.dirname(__file__), "crash_driver.py")
+
+
+class FlakySink(RecordingNotifier):
+    """Records like RecordingNotifier, but fails while `down` or for `poison` ids."""
+
+    def __init__(self):
+        super().__init__()
+        self.down = False
+        self.poison: set[str] = set()
+        self.attempts = 0
+
+    def send(self, notification: dict) -> None:
+        self.attempts += 1
+        if self.down:
+            raise NotifyError("sink unreachable")
+        if notification["event_id"] in self.poison:
+            raise NotifyError("sink returned 400")
+        super().send(notification)
+
+
+@pytest.fixture
+def flaky(store):
+    sink = FlakySink()
+    return Dispatcher(store, sink), sink
+
+
+# -- 1. idempotency ---------------------------------------------------------
+
+
+def test_retry_returns_original_result_without_effects(dispatcher, store, notifier):
+    first = dispatcher.handle(cmd("create", "j1", command_id="c1", priority=1))
+    again = dispatcher.handle(cmd("create", "j1", command_id="c1", priority=1))
+    assert again == first
+    assert len(store.read_events()) == 1
+    assert len(notifier.sent) == 1
+    assert store.pending_notifications() == []
+
+
+def test_retry_of_rejection_returns_same_rejection(dispatcher, store):
+    dispatcher.handle(cmd("create", "j1"))
+    first = dispatcher.handle(cmd("complete", "j1", command_id="c-early"))
+    assert first == {"ok": False, "error": "INVALID_TRANSITION"}
+    dispatcher.handle(cmd("start", "j1"))
+    assert dispatcher.handle(cmd("complete", "j1", command_id="c-early")) == first
+    assert store.get_job("j1").state == "running"
+
+
+def test_key_reuse_with_different_payload_rejected(dispatcher, store, notifier):
+    dispatcher.handle(cmd("create", "j1", command_id="c1", priority=1))
+    res = dispatcher.handle(cmd("create", "j1", command_id="c1", priority=2))
+    assert res == {"ok": False, "error": "IDEMPOTENCY_KEY_REUSED"}
+    res = dispatcher.handle(cmd("start", "j1", command_id="c1"))
+    assert res == {"ok": False, "error": "IDEMPOTENCY_KEY_REUSED"}
+    assert store.get_job("j1").state == "queued"
+    assert len(notifier.sent) == 1
+
+
+def test_retry_survives_restart(store, notifier, tmp_path):
+    from relay.store import Store
+
+    d1 = Dispatcher(store, notifier)
+    first = d1.handle(cmd("create", "j1", command_id="c1"))
+    store2 = Store(str(tmp_path / "relay.db"))
+    try:
+        d2 = Dispatcher(store2, notifier)
+        assert d2.handle(cmd("create", "j1", command_id="c1")) == first
+        assert len(store2.read_events()) == 1
+    finally:
+        store2.close()
+
+
+# -- 2. terminal states absorb; 5. cancel -----------------------------------
+
+
+@pytest.mark.parametrize("finish", ["complete", "fail", "cancel"])
+def test_terminal_states_absorb_every_command(dispatcher, store, notifier, finish):
+    dispatcher.handle(cmd("create", "j1"))
+    dispatcher.handle(cmd("start", "j1"))
+    res = dispatcher.handle(cmd(finish, "j1"))
+    assert res["ok"]
+    terminal = res["state"]
+    assert store.get_job("j1").terminal
+    events_before, sent_before = len(store.read_events()), len(notifier.sent)
+    for ctype in ("start", "complete", "fail", "cancel"):
+        assert dispatcher.handle(cmd(ctype, "j1")) == {
+            "ok": False,
+            "error": "INVALID_TRANSITION",
+        }
+    assert store.get_job("j1").state == terminal
+    assert len(store.read_events()) == events_before
+    assert len(notifier.sent) == sent_before
+    assert store.pending_notifications() == []
+
+
+def test_cancel_from_queued(dispatcher, store, notifier):
+    dispatcher.handle(cmd("create", "j1"))
+    res = dispatcher.handle(cmd("cancel", "j1"))
+    assert res["ok"] and res["state"] == "cancelled"
+    assert store.get_job("j1").state == "cancelled"
+    assert (
+        notifier.sent[-1]["state"] == "cancelled"
+        and notifier.sent[-1]["type"] == "cancel"
+    )
+
+
+def test_cancel_from_running(dispatcher, store):
+    dispatcher.handle(cmd("create", "j1"))
+    dispatcher.handle(cmd("start", "j1"))
+    assert dispatcher.handle(cmd("cancel", "j1"))["state"] == "cancelled"
+    assert [e["type"] for e in store.read_events("j1")] == ["create", "start", "cancel"]
+
+
+def test_start_still_allowed_from_running(dispatcher):
+    dispatcher.handle(cmd("create", "j1"))
+    dispatcher.handle(cmd("start", "j1"))
+    assert dispatcher.handle(cmd("start", "j1"))["state"] == "running"
+
+
+# -- 3. durable outbox ------------------------------------------------------
+
+
+def test_sink_failure_does_not_fail_or_roll_back_handle(flaky, store):
+    dispatcher, sink = flaky
+    sink.down = True
+    res = dispatcher.handle(cmd("create", "j1"))
+    assert res["ok"] and res["state"] == "queued"
+    assert store.get_job("j1").state == "queued"
+    assert [e["event_id"] for e in store.read_events()] == [res["event_id"]]
+    assert [p["event_id"] for p in store.pending_notifications()] == [res["event_id"]]
+    assert sink.sent == []
+
+
+def test_pump_delivers_backlog_once_sink_returns(flaky, store):
+    dispatcher, sink = flaky
+    sink.down = True
+    ids = [
+        dispatcher.handle(c)["event_id"]
+        for c in (cmd("create", "j1"), cmd("start", "j1"), cmd("create", "j2"))
+    ]
+    assert dispatcher.pump() == 0
+    assert len(store.pending_notifications()) == 3
+    sink.down = False
+    assert dispatcher.pump() == 3
+    assert [n["event_id"] for n in sink.sent] == ids
+    assert store.pending_notifications() == []
+    assert dispatcher.pump() == 0
+    assert len(sink.sent) == 3
+
+
+def test_rejected_notification_does_not_block_others(flaky, store):
+    dispatcher, sink = flaky
+    sink.down = True
+    bad = dispatcher.handle(cmd("create", "j1"))["event_id"]
+    good = dispatcher.handle(cmd("create", "j2"))["event_id"]
+    sink.down = False
+    sink.poison = {bad}
+    assert dispatcher.pump() == 1
+    assert [n["event_id"] for n in sink.sent] == [good]
+    assert [p["event_id"] for p in store.pending_notifications()] == [bad]
+    # New commands are still announced immediately while the bad one waits.
+    later = dispatcher.handle(cmd("start", "j2"))["event_id"]
+    assert [n["event_id"] for n in sink.sent] == [good, later]
+    sink.poison = set()
+    assert dispatcher.pump() == 1
+    assert store.pending_notifications() == []
+
+
+def test_unexpected_sink_exception_is_contained(store):
+    class Boom(RecordingNotifier):
+        def send(self, notification):
+            raise RuntimeError("bug in sink client")
+
+    dispatcher = Dispatcher(store, Boom())
+    res = dispatcher.handle(cmd("create", "j1"))
+    assert res["ok"]
+    assert dispatcher.pump() == 0
+    row = store.conn.execute("SELECT attempts, last_error FROM outbox").fetchone()
+    assert row[0] == 2 and "bug in sink client" in row[1]
+
+
+# -- 4. crash safety --------------------------------------------------------
+
+EXPECTED_TYPES = {"j1": ["create", "start", "complete"], "j2": ["create", "cancel"]}
+
+
+def _run_driver(tmp, mode, fault=None, sink_down=False):
+    env = (
+        {**os.environ, "RELAY_FAULT": fault}
+        if fault
+        else {k: v for k, v in os.environ.items() if k != "RELAY_FAULT"}
+    )
+    args = [sys.executable, DRIVER, str(tmp / "relay.db"), str(tmp / "sink.log"), mode]
+    if sink_down:
+        args.append("--sink-down")
+    proc = subprocess.run(
+        args, env=env, capture_output=True, text=True, timeout=60, check=False
+    )
+    dumps = [json.loads(line) for line in proc.stdout.splitlines() if line.strip()]
+    return proc.returncode, dumps, proc.stderr
+
+
+def _check_consistent(dump):
+    events = dump["events"]
+    last_state = {}
+    for e in events:
+        last_state[e["job_id"]] = e["state"]
+    assert dump["jobs"] == last_state, "jobs table must equal the fold of the event log"
+    for job_id, types in EXPECTED_TYPES.items():
+        got = [e["type"] for e in events if e["job_id"] == job_id]
+        assert got == types[: len(got)], f"{job_id}: {got} is not a prefix of {types}"
+    assert len({e["event_id"] for e in events}) == len(events)
+
+
+def _check_recovered(dump):
+    _check_consistent(dump)
+    committed = {e["event_id"] for e in dump["events"]}
+    assert set(dump["announced"]) == committed, (
+        "announce every committed event and only committed events"
+    )
+    assert dump["pending"] == []
+
+
+def _crash_case(tmp_root, kind, n, sink_down):
+    tmp = tmp_root / f"{kind}-{n}-{'down' if sink_down else 'up'}"
+    tmp.mkdir()
+    crash_code, dumps, stderr = _run_driver(
+        tmp, "run", fault=f"{kind}:{n}", sink_down=sink_down
+    )
+    assert crash_code in (0, 137), stderr
+    if crash_code == 0:
+        _check_consistent(dumps[0])
+    code, dumps, stderr = _run_driver(tmp, "recover")
+    assert code == 0, stderr
+    after_pump, after_replay = dumps
+    _check_recovered(after_pump)
+    _check_recovered(after_replay)
+    events = after_replay["events"]
+    for job_id, types in EXPECTED_TYPES.items():
+        assert [e["type"] for e in events if e["job_id"] == job_id] == types
+    results = after_replay["results"]
+    assert results["c5"] == {"ok": False, "error": "INVALID_TRANSITION"}
+    by_command = {e["command_id"]: e["event_id"] for e in events}
+    for cid, res in results.items():
+        if res["ok"]:
+            assert res["event_id"] == by_command[cid]
+    return crash_code == 0
+
+
+@pytest.mark.parametrize("sink_down", [False, True], ids=["sink-up", "sink-down"])
+@pytest.mark.parametrize("kind", ["write", "commit"])
+def test_crash_at_every_write_and_commit(tmp_path, kind, sink_down):
+    max_n = 60
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        completed = list(
+            pool.map(
+                lambda n: _crash_case(tmp_path, kind, n, sink_down), range(1, max_n + 1)
+            )
+        )
+    # Some fault points must actually have crashed, and the run must finish
+    # without crashing once the fault point is past the end of the sequence.
+    crashed = [n for n, ok in zip(range(1, max_n + 1), completed) if not ok]
+    assert crashed, "no fault point crashed; the harness is not exercising crashes"
+    assert len(crashed) >= 8
+    assert completed[-1], f"a {kind} fault at {max_n} still crashed; raise max_n"
+
+
+def test_no_fault_baseline(tmp_path):
+    code, dumps, stderr = _run_driver(tmp_path, "run")
+    assert code == 0, stderr
+    _check_recovered(dumps[0])
+    assert {e["type"] for e in dumps[0]["events"]} == {
+        "create",
+        "start",
+        "complete",
+        "cancel",
+    }
