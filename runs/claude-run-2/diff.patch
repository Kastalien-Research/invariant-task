+    # -- commands (idempotency) --------------------------------------------
+    def get_command(self, command_id: str) -> tuple[str, dict] | None:
+        """Return (fingerprint, result) for a previously handled command."""
+        row = self.conn.execute(
+            "SELECT fingerprint, result FROM commands WHERE command_id = ?", (command_id,)
+        ).fetchone()
+        return (row[0], json.loads(row[1])) if row else None
+
+    def record_command(self, command_id: str, fingerprint: str, result: dict) -> None:
+        self.conn.execute(
+            "INSERT INTO commands (command_id, fingerprint, result, created_at) VALUES (?, ?, ?, ?)",
+            (command_id, fingerprint, json.dumps(result), time.time()),
+        )
+
+    # -- outbox -------------------------------------------------------------
+    def enqueue_notification(self, event_id: str) -> None:
+        self.conn.execute("INSERT INTO outbox (event_id) VALUES (?)", (event_id,))
+
+    def pending_notifications(self) -> list[dict]:
+        """Committed events the sink has not acknowledged, oldest first."""
+        rows = self.conn.execute(
+            "SELECT e.event_id, e.job_id, e.type, e.state FROM outbox o "
+            "JOIN events e ON e.event_id = o.event_id ORDER BY e.seq"
+        ).fetchall()
+        keys = ("event_id", "job_id", "type", "state")
+        return [dict(zip(keys, r)) for r in rows]
+
+    def mark_delivered(self, event_id: str) -> None:
+        self.conn.execute("DELETE FROM outbox WHERE event_id = ?", (event_id,))
+
+    def mark_delivery_failed(self, event_id: str, error: str) -> None:
+        self.conn.execute(
+            "UPDATE outbox SET attempts = attempts + 1, last_error = ? WHERE event_id = ?",
+            (error, event_id),
+        )
+
     def close(self) -> None:
         self.conn.close()
