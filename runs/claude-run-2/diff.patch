--- /dev/null
+++ b/tests/crash_driver.py
@@ -0,0 +1,105 @@
+"""Subprocess driver for the crash-safety tests.
+
+    python crash_driver.py DB_PATH SINK_PATH MODE [--sink-down]
+
+MODE "run":     handle the scripted command sequence, then pump().
+MODE "recover": pump() only (what a restarted host does), dump state, then
+                replay the same command sequence as a retrying caller would,
+                pump() again, dump state again.
+
+The sink is a file: each accepted notification is appended as one JSON
+line. With --sink-down every send raises NotifyError. State dumps are
+printed as JSON lines on stdout. RELAY_FAULT is honoured by relay.store.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from relay.dispatcher import Dispatcher
+from relay.notifier import Notifier, NotifyError
+from relay.store import Store
+
+# (command_id, type, job_id). c5 is rejected: complete from queued.
+COMMANDS = [
+    ("c1", "create", "j1"),
+    ("c2", "start", "j1"),
+    ("c3", "complete", "j1"),
+    ("c4", "create", "j2"),
+    ("c5", "complete", "j2"),
+    ("c6", "cancel", "j2"),
+]
+
+
+class FileSink(Notifier):
+    def __init__(self, path: str, down: bool):
+        super().__init__(sink_url="file://" + path)
+        self.path = path
+        self.down = down
+
+    def send(self, notification: dict) -> None:
+        if self.down:
+            raise NotifyError("sink down")
+        with open(self.path, "a") as f:
+            f.write(json.dumps(notification) + "\n")
+
+
+def announced(path: str) -> list[str]:
+    if not os.path.exists(path):
+        return []
+    with open(path) as f:
+        return [json.loads(line)["event_id"] for line in f if line.strip()]
+
+
+def dump(store: Store, sink_path: str, results: dict) -> None:
+    jobs = store.conn.execute(
+        "SELECT job_id, state FROM jobs ORDER BY job_id"
+    ).fetchall()
+    print(
+        json.dumps(
+            {
+                "jobs": dict(jobs),
+                "events": store.read_events(),
+                "pending": store.pending_notifications(),
+                "announced": announced(sink_path),
+                "results": results,
+            }
+        ),
+        flush=True,
+    )
+
+
+def replay(dispatcher: Dispatcher) -> dict:
+    results = {}
+    for cid, ctype, job_id in COMMANDS:
+        results[cid] = dispatcher.handle(
+            {"command_id": cid, "type": ctype, "job_id": job_id, "payload": {}}
+        )
+    return results
+
+
+def main() -> None:
+    db_path, sink_path, mode = sys.argv[1:4]
+    down = "--sink-down" in sys.argv
+    store = Store(db_path)
+    dispatcher = Dispatcher(store, FileSink(sink_path, down))
+    if mode == "run":
+        results = replay(dispatcher)
+        dispatcher.pump()
+        dump(store, sink_path, results)
+    elif mode == "recover":
+        dispatcher.pump()
+        dump(store, sink_path, {})
+        results = replay(dispatcher)
+        dispatcher.pump()
+        dump(store, sink_path, results)
+    else:
+        raise SystemExit(f"unknown mode {mode}")
+
+
+if __name__ == "__main__":
+    main()
