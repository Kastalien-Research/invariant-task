diff --git a/tests/test_reliability.py b/tests/test_reliability.py
new file mode 100644
index 0000000..ac3d85f
--- /dev/null
+++ b/tests/test_reliability.py
@@ -0,0 +1,147 @@
+from relay.dispatcher import Dispatcher
+from relay.notifier import Notifier, NotifyError
+from relay.store import Store
+
+from conftest import cmd
+
+
+class ToggleNotifier(Notifier):
+    def __init__(self, failing=True):
+        super().__init__(sink_url="memory://")
+        self.failing = failing
+        self.sent: list[dict] = []
+
+    def send(self, notification: dict) -> None:
+        if self.failing:
+            raise NotifyError("sink unavailable")
+        self.sent.append(notification)
+
+
+def test_identical_command_retry_returns_original_result_without_effects(
+    dispatcher, store, notifier
+):
+    command = cmd("create", "j1", command_id="command-1", priority="high")
+
+    first = dispatcher.handle(command)
+    events_after_first = store.read_events()
+    notifications_after_first = list(notifier.sent)
+
+    assert dispatcher.handle(command) == first
+    assert store.read_events() == events_after_first
+    assert notifier.sent == notifications_after_first
+
+
+def test_reusing_command_id_for_different_payload_is_rejected(dispatcher, store):
+    dispatcher.handle(cmd("create", "j1", command_id="command-1", priority="high"))
+
+    result = dispatcher.handle(
+        cmd("create", "j1", command_id="command-1", priority="low")
+    )
+
+    assert result == {"ok": False, "error": "IDEMPOTENCY_KEY_REUSED"}
+    assert len(store.read_events()) == 1
+
+
+def test_rejected_command_retry_returns_original_rejection(dispatcher, store):
+    command = cmd("complete", "j1", command_id="command-1")
+    assert dispatcher.handle(command) == {"ok": False, "error": "JOB_NOT_FOUND"}
+
+    dispatcher.handle(cmd("create", "j1"))
+    dispatcher.handle(cmd("start", "j1"))
+
+    assert dispatcher.handle(command) == {"ok": False, "error": "JOB_NOT_FOUND"}
+    assert [event["type"] for event in store.read_events("j1")] == ["create", "start"]
+
+
+def test_terminal_job_rejects_commands_without_effects(dispatcher, store, notifier):
+    dispatcher.handle(cmd("create", "j1"))
+    dispatcher.handle(cmd("start", "j1"))
+    dispatcher.handle(cmd("complete", "j1"))
+    event_count = len(store.read_events())
+    notification_count = len(notifier.sent)
+
+    result = dispatcher.handle(cmd("start", "j1"))
+
+    assert result == {"ok": False, "error": "INVALID_TRANSITION"}
+    assert store.get_job("j1").state == "succeeded"
+    assert len(store.read_events()) == event_count
+    assert len(notifier.sent) == notification_count
+
+
+def test_cancel_moves_queued_and_running_jobs_to_cancelled(dispatcher, store):
+    dispatcher.handle(cmd("create", "queued-job"))
+    dispatcher.handle(cmd("create", "running-job"))
+    dispatcher.handle(cmd("start", "running-job"))
+
+    queued_result = dispatcher.handle(cmd("cancel", "queued-job"))
+    running_result = dispatcher.handle(cmd("cancel", "running-job"))
+
+    assert queued_result["ok"] and queued_result["state"] == "cancelled"
+    assert running_result["ok"] and running_result["state"] == "cancelled"
+    assert store.get_job("queued-job").terminal
+    assert store.get_job("running-job").terminal
+
+
+def test_notifier_failure_does_not_fail_handle_and_pump_retries(tmp_path):
+    store = Store(str(tmp_path / "relay.db"))
+    notifier = ToggleNotifier()
+    dispatcher = Dispatcher(store, notifier)
+
+    result = dispatcher.handle(cmd("create", "j1"))
+    assert result["ok"] and store.get_job("j1").state == "queued"
+
+    notifier.failing = False
+    assert dispatcher.pump() == 1
+    assert notifier.sent == [
+        {
+            "event_id": result["event_id"],
+            "job_id": "j1",
+            "type": "create",
+            "state": "queued",
+        }
+    ]
+    assert dispatcher.pump() == 0
+    store.close()
+
+
+def test_pending_notification_survives_store_restart(tmp_path):
+    path = str(tmp_path / "relay.db")
+    failing_notifier = ToggleNotifier()
+    first_store = Store(path)
+    result = Dispatcher(first_store, failing_notifier).handle(cmd("create", "j1"))
+    first_store.close()
+
+    recovering_notifier = ToggleNotifier(failing=False)
+    restarted_store = Store(path)
+    restarted = Dispatcher(restarted_store, recovering_notifier)
+
+    assert restarted_store.get_job("j1").state == "queued"
+    assert restarted.pump() == 1
+    assert recovering_notifier.sent[0]["event_id"] == result["event_id"]
+    restarted_store.close()
+
+
+def test_send_that_reports_failure_is_redelivered(tmp_path):
+    class AmbiguousNotifier(ToggleNotifier):
+        def __init__(self):
+            super().__init__(failing=False)
+            self.ambiguous = True
+
+        def send(self, notification: dict) -> None:
+            self.sent.append(notification)
+            if self.ambiguous:
+                raise NotifyError("response lost after sink accepted event")
+
+    store = Store(str(tmp_path / "relay.db"))
+    notifier = AmbiguousNotifier()
+    dispatcher = Dispatcher(store, notifier)
+    result = dispatcher.handle(cmd("create", "j1"))
+    assert len(notifier.sent) == 1
+
+    notifier.ambiguous = False
+    assert dispatcher.pump() == 1
+    assert [item["event_id"] for item in notifier.sent] == [
+        result["event_id"],
+        result["event_id"],
+    ]
+    store.close()
