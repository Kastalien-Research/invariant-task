@@ -0,0 +1,253 @@
+"""Idempotency, absorbing terminal states, the outbox, cancel, and crash recovery."""
+import json
+import os
+import subprocess
+import sys
+import textwrap
+
+import pytest
+from conftest import RecordingNotifier, cmd
+
+from relay.dispatcher import Dispatcher
+from relay.notifier import NotifyError
+from relay.store import Store
+
+
+class FlakySink(RecordingNotifier):
+    def __init__(self):
+        super().__init__()
+        self.up = True
+
+    def send(self, notification):
+        if not self.up:
+            raise NotifyError("sink down")
+        super().send(notification)
+
+
+@pytest.fixture
+def sink():
+    return FlakySink()
+
+
+@pytest.fixture
+def flaky(store, sink):
+    return Dispatcher(store, sink)
+
+
+# -- idempotency ------------------------------------------------------------
+
+def test_retry_replays_original_result_without_effects(dispatcher, store, notifier):
+    first = dispatcher.handle(cmd("create", "j1", command_id="c1"))
+    again = dispatcher.handle(cmd("create", "j1", command_id="c1"))
+    assert again == first
+    assert len(store.read_events()) == 1
+    assert len(notifier.sent) == 1
+
+
+def test_retry_of_rejection_replays_rejection(dispatcher):
+    dispatcher.handle(cmd("create", "j1"))
+    first = dispatcher.handle(cmd("complete", "j1", command_id="c1"))
+    assert first == {"ok": False, "error": "INVALID_TRANSITION"}
+    dispatcher.handle(cmd("start", "j1"))
+    # Same command id, same payload: original answer, even though it would now succeed.
+    assert dispatcher.handle(cmd("complete", "j1", command_id="c1")) == first
+
+
+def test_same_command_id_different_payload_rejected(dispatcher, store):
+    dispatcher.handle(cmd("create", "j1", command_id="c1", priority=1))
+    res = dispatcher.handle(cmd("create", "j1", command_id="c1", priority=2))
+    assert res == {"ok": False, "error": "IDEMPOTENCY_KEY_REUSED"}
+    res = dispatcher.handle(cmd("start", "j1", command_id="c1"))
+    assert res == {"ok": False, "error": "IDEMPOTENCY_KEY_REUSED"}
+    assert store.get_job("j1").state == "queued"
+
+
+# -- terminal states --------------------------------------------------------
+
+@pytest.mark.parametrize("finisher", ["complete", "fail", "cancel"])
+def test_terminal_states_absorb_every_command(dispatcher, store, notifier, finisher):
+    dispatcher.handle(cmd("create", "j1"))
+    dispatcher.handle(cmd("start", "j1"))
+    res = dispatcher.handle(cmd(finisher, "j1"))
+    assert res["ok"]
+    final = store.get_job("j1").state
+    sent_before = len(notifier.sent)
+    for ctype in ("start", "complete", "fail", "cancel"):
+        assert dispatcher.handle(cmd(ctype, "j1")) == {"ok": False, "error": "INVALID_TRANSITION"}
+    assert store.get_job("j1").state == final
+    assert len(notifier.sent) == sent_before
+    assert len(store.read_events("j1")) == 3
+
+
+# -- cancel -----------------------------------------------------------------
+
+def test_cancel_from_queued_and_running(dispatcher, notifier):
+    dispatcher.handle(cmd("create", "j1"))
+    assert dispatcher.handle(cmd("cancel", "j1"))["state"] == "cancelled"
+    dispatcher.handle(cmd("create", "j2"))
+    dispatcher.handle(cmd("start", "j2"))
+    assert dispatcher.handle(cmd("cancel", "j2"))["state"] == "cancelled"
+    assert [n["state"] for n in notifier.sent if n["type"] == "cancel"] == ["cancelled", "cancelled"]
+
+
+# -- outbox -----------------------------------------------------------------
+
+def test_sink_failure_does_not_fail_handle(flaky, store, sink):
+    sink.up = False
+    res = flaky.handle(cmd("create", "j1"))
+    assert res["ok"] and res["state"] == "queued"
+    assert store.get_job("j1").state == "queued"
+    assert len(store.read_events()) == 1
+    assert sink.sent == []
+
+
+def test_pump_delivers_backlog_in_order_once_sink_returns(flaky, store, sink):
+    sink.up = False
+    flaky.handle(cmd("create", "j1"))
+    flaky.handle(cmd("start", "j1"))
+    flaky.handle(cmd("complete", "j1"))
+    assert flaky.pump() == 0
+    sink.up = True
+    assert flaky.pump() == 3
+    assert [n["state"] for n in sink.sent] == ["queued", "running", "succeeded"]
+    assert [n["event_id"] for n in sink.sent] == [e["event_id"] for e in store.read_events()]
+    assert flaky.pump() == 0
+    assert len(sink.sent) == 3
+
+
+def test_handle_preserves_order_while_backlog_exists(flaky, sink):
+    sink.up = False
+    flaky.handle(cmd("create", "j1"))
+    sink.up = True
+    flaky.handle(cmd("start", "j1"))
+    assert [n["state"] for n in sink.sent] == ["queued", "running"]
+
+
+# -- crash safety -----------------------------------------------------------
+
+CHILD = textwrap.dedent(
+    """
+    import json, os, sys
+    from relay.dispatcher import Dispatcher
+    from relay.notifier import Notifier, NotifyError
+    from relay.store import Store
+
+    class FileSink(Notifier):
+        def __init__(self, path, up, die_after_send):
+            super().__init__("memory://")
+            self.path, self.up, self.die_after_send = path, up, die_after_send
+        def send(self, n):
+            if not self.up:
+                raise NotifyError("down")
+            with open(self.path, "a") as f:
+                f.write(json.dumps(n) + "\\n")
+            if self.die_after_send:
+                os._exit(137)
+
+    db, sink_path, up, die = sys.argv[1], sys.argv[2], sys.argv[3] == "up", sys.argv[4] == "die"
+    d = Dispatcher(Store(db), FileSink(sink_path, up, die))
+    for line in sys.stdin:
+        line = line.strip()
+        if line == "PUMP":
+            print(json.dumps({"pumped": d.pump()}), flush=True)
+        elif line:
+            print(json.dumps(d.handle(json.loads(line))), flush=True)
+    """
+)
+
+
+class Child:
+    def __init__(self, tmp_path):
+        self.db = str(tmp_path / "relay.db")
+        self.sink = str(tmp_path / "sink.jsonl")
+
+    def run(self, lines, fault=None, up=True, die_after_send=False):
+        env = {k: v for k, v in os.environ.items() if k != "RELAY_FAULT"}
+        if fault:
+            env["RELAY_FAULT"] = fault
+        proc = subprocess.run(
+            [sys.executable, "-c", CHILD, self.db, self.sink, "up" if up else "down", "die" if die_after_send else "live"],
+            input="\n".join(json.dumps(l) if isinstance(l, dict) else l for l in lines) + "\n",
+            capture_output=True,
+            text=True,
+            env=env,
+            cwd=os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+        )
+        outputs = [json.loads(l) for l in proc.stdout.splitlines() if l.strip()]
+        return proc.returncode, outputs
+
+    def sink_events(self):
+        if not os.path.exists(self.sink):
+            return []
+        with open(self.sink) as f:
+            return [json.loads(l) for l in f if l.strip()]
+
+    def store(self):
+        return Store(self.db)
+
+
+def test_crash_after_commit_before_notify_is_recovered_by_pump(tmp_path):
+    child = Child(tmp_path)
+    # Sink down: each accepted command is exactly one commit. Die after the 2nd.
+    rc, out = child.run([cmd("create", "j1", "c1"), cmd("start", "j1", "c2"), cmd("complete", "j1", "c3")],
+                        fault="commit:2", up=False)
+    assert rc == 137
+    assert child.sink_events() == []
+    store = child.store()
+    assert store.get_job("j1").state == "running"
+    assert [e["type"] for e in store.read_events("j1")] == ["create", "start"]
+    store.close()
+
+    rc, out = child.run(["PUMP"], up=True)
+    assert rc == 0 and out == [{"pumped": 2}]
+    assert [e["state"] for e in child.sink_events()] == ["queued", "running"]
+    assert child.run(["PUMP"])[1] == [{"pumped": 0}]
+
+
+def test_crash_mid_transaction_leaves_no_trace_and_retry_applies(tmp_path):
+    child = Child(tmp_path)
+    # create = 4 writes (job, event, outbox, command) then commit; sink down so
+    # no delivery writes follow. Die on the 2nd write of `start`, before commit.
+    rc, out = child.run([cmd("create", "j1", "c1"), cmd("start", "j1", "c2")], fault="write:6", up=False)
+    assert rc == 137
+    store = child.store()
+    assert store.get_job("j1").state == "queued"
+    assert [e["type"] for e in store.read_events("j1")] == ["create"]
+    assert store.get_command("c2") is None
+    store.close()
+
+    rc, out = child.run([cmd("start", "j1", "c2"), "PUMP"], up=True)
+    assert rc == 0
+    assert out[0]["ok"] and out[0]["state"] == "running"
+    assert out[1] == {"pumped": 0}
+    assert [e["state"] for e in child.sink_events()] == ["queued", "running"]
+    store = child.store()
+    assert store.get_job("j1").state == "running"
+    assert store.pending_notifications() == []
+    store.close()
+
+
+def test_crash_after_send_before_ack_redelivers_same_event_id(tmp_path):
+    child = Child(tmp_path)
+    rc, out = child.run([cmd("create", "j1", "c1")], die_after_send=True)
+    assert rc == 137
+    first = child.sink_events()
+    assert [e["state"] for e in first] == ["queued"]
+
+    rc, out = child.run(["PUMP"])
+    assert rc == 0 and out == [{"pumped": 1}]
+    events = child.sink_events()
+    assert len(events) == 2 and events[0]["event_id"] == events[1]["event_id"]
+    assert child.run(["PUMP"])[1] == [{"pumped": 0}]
+
+
+def test_uncommitted_event_is_never_announced(tmp_path):
+    child = Child(tmp_path)
+    rc, _ = child.run([cmd("create", "j1", "c1"), cmd("start", "j1", "c2")], fault="write:7", up=True)
+    assert rc == 137
+    rc, out = child.run(["PUMP"])
+    assert out == [{"pumped": 0}]
+    assert [e["state"] for e in child.sink_events()] == ["queued"]
+    store = child.store()
+    assert store.get_job("j1").state == "queued"
+    store.close()
